<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>

<body style="
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
    background-color:#f4f6f8;
">

    <!-- Header -->
    <header style="
        height:70px;
        background-color:#2563eb;
        display:flex;
        align-items:center;
        justify-content:space-between;
        padding:0 50px;
        color:white;
    ">

        <div style="
            font-size:24px;
            font-weight:bold;
        ">
            My Website
        </div>

        <div>
            <button onclick="window.location.href='@Url.Action("Login", "Home")'"
                    style="
            padding:10px 20px;
            margin-right:10px;
            border:1px solid white;
            border-radius:6px;
            background-color:transparent;
            color:white;
            font-size:14px;
            cursor:pointer;
        ">
                Login
            </button>

            <button onclick="window.location.href='@Url.Action("Register", "Home")'"
                    style="
            padding:10px 20px;
            border:none;
            border-radius:6px;
            background-color:white;
            color:#2563eb;
            font-size:14px;
            cursor:pointer;
        ">
                Register
            </button>
        </div>

    </header>


    <!-- Main UI -->
    <main style="
        min-height:calc(100vh - 70px);
        display:flex;
        align-items:center;
        justify-content:center;
        text-align:center;
    ">

        <div style="
            width:600px;
            padding:50px;
        ">

            <h1 style="
                font-size:42px;
                color:#222;
                margin-bottom:15px;
            ">
                Welcome to My Website
            </h1>

            <p style="
                font-size:18px;
                color:#666;
                line-height:1.6;
                margin-bottom:30px;
            ">
                A simple and clean website where you can manage
                your account and access your dashboard.
            </p>

            <div style="
                background-color:white;
                padding:30px;
                border-radius:12px;
                box-shadow:0 5px 20px rgba(0,0,0,0.08);
            ">

                <h2 style="
                    color:#333;
                    margin-top:0;
                ">
                    Get Started
                </h2>

                <p style="
                    color:#777;
                    margin-bottom:25px;
                ">
                    Login to your account or create a new account.
                </p>

                <button onclick="window.location.href='@Url.Action("Login", "Home")'"
                        style="
            padding:12px 30px;
            margin-right:10px;
            border:none;
            border-radius:6px;
            background-color:#2563eb;
            color:white;
            font-size:15px;
            cursor:pointer;
        ">
                    Login
                </button>

                <button onclick="window.location.href='@Url.Action("Register", "Home")'"
                        style="
            padding:12px 30px;
            border:1px solid #2563eb;
            border-radius:6px;
            background-color:white;
            color:#2563eb;
            font-size:15px;
            cursor:pointer;
        ">
                    Register
                </button>

                <button onclick="window.location.href='@Url.Action("ForgotPassword", "Home")'"
                        style="
            padding:12px 30px;
            border:1px solid #2563eb;
            border-radius:6px;
            background-color:white;
            color:#2563eb;
            font-size:15px;
            cursor:pointer;
        ">
                    Forgot Password
                </button>


                <button onclick="window.location.href='@Url.Action("ResetPassword", "Home")'"
                        style="
            padding:12px 30px;
            border:1px solid #2563eb;
            border-radius:6px;
            background-color:white;
            color:#2563eb;
            font-size:15px;
            cursor:pointer;
        ">
                    Reset Password
                </button>

            </div>

        </div>

    </main>

</body>
</html>