<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Reset Password</title>
</head>

<body style="
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
    background-color:#f4f6f8;
">

    <div style="
        width:400px;
        margin:100px auto;
        padding:35px;
        background-color:white;
        border-radius:10px;
        box-shadow:0 4px 15px rgba(0,0,0,0.1);
    ">

        <h2 style="
            text-align:center;
            color:#333;
            margin:0 0 10px 0;
        ">
            Reset Password
        </h2>

        <p style="
            text-align:center;
            color:#777;
            font-size:14px;
            margin-bottom:25px;
        ">
            Create a new password for your account.
        </p>

        <form>

            <label style="
                display:block;
                margin-bottom:6px;
                color:#444;
                font-size:14px;
            ">
                New Password
            </label>

            <input type="password"
                   placeholder="Enter new password"
                   style="
                       width:100%;
                       box-sizing:border-box;
                       padding:12px;
                       margin-bottom:18px;
                       border:1px solid #ccc;
                       border-radius:6px;
                       font-size:14px;
                       outline:none;
                   ">

            <label style="
                display:block;
                margin-bottom:6px;
                color:#444;
                font-size:14px;
            ">
                Confirm Password
            </label>

            <input type="password"
                   placeholder="Confirm new password"
                   style="
                       width:100%;
                       box-sizing:border-box;
                       padding:12px;
                       margin-bottom:22px;
                       border:1px solid #ccc;
                       border-radius:6px;
                       font-size:14px;
                       outline:none;
                   ">

            <button type="submit"
                    style="
                        width:100%;
                        padding:12px;
                        border:none;
                        border-radius:6px;
                        background-color:#2563eb;
                        color:white;
                        font-size:16px;
                        cursor:pointer;
                    ">
                Reset Password
            </button>

        </form>

        <div style="
            text-align:center;
            margin-top:20px;
        ">
            <a href="@Url.Action("Login", "Home")"
               style="
                   color:#2563eb;
                   text-decoration:none;
                   font-size:14px;
               ">
                ← Back to Login
            </a>
        </div>

    </div>

</body>
</html>