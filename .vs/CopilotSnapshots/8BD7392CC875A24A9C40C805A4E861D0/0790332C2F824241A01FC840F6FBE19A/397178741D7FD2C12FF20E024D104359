@model MVCWithADO.Models.Student

@{
    ViewBag.Title = "EditStudent";
}

<h2 style="text-align:center;background-color:yellowgreen;color:orangered">
    Edit Student Details
</h2>

@using (Html.BeginForm("EditStudent", "Student", FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(S => S.Sid)

    <div>
        @Html.LabelFor(S => S.Name)<br />
        @Html.TextBoxFor(S => S.Name)
    </div>

    <div>
        @Html.LabelFor(S => S.Class)<br />
        @Html.TextBoxFor(S => S.Class)
    </div>

    <div>
        @Html.LabelFor(S => S.Fees)<br />
        @Html.TextBoxFor(S => S.Fees)
    </div>

    <div>
        @Html.LabelFor(S => S.Photo)<br />

        @if (!string.IsNullOrEmpty(Model.Photo))
        {
            <img src="@Url.Content("~/Uploads/" + Model.Photo)"
                 width="100" height="100" />
        }

        <input type="file" name="selectedFile" />
    </div>

    <div>
        <input type="submit" value="Update" />
        <input type="reset" value="Reset" />
    </div>
}

@Html.ActionLink("Back to Student Details", "DisplayStudent")