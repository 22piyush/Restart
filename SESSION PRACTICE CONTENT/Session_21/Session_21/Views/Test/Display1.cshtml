

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Display1</title>
</head>
<body>
    <div>
        <h2>Dispaly</h2>

        <table border="1" cellpadding="10" cellspacing="0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@ViewBag.Id</td>
                    <td>@ViewBag.Name</td>
                    <td>
                        @{
                            double? price = ViewBag.Price;
                            price = price + price * 0.1;
                        }
                        @price
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>
