@{
    Layout = null;
    ViewBag.Title = "Home";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NOT - @ViewBag.Title</title>

    <!-- Bootstrap CSS (CDN, no NuGet needed) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <div class="container-fluid d-flex flex-column flex-grow-1 p-3 gap-3">

        <!-- Row 1: Header (logo on the left, title on the right) -->
        <div class="row border rounded bg-primary text-white align-items-center">
            <!-- Logo box -->
            <div class="col-3 col-md-2 py-3">
                <div class="border border-light rounded bg-white text-primary fw-bold text-center py-2">
                    LOGO
                </div>
            </div>
            <!-- Header content -->
            <div class="col-9 col-md-10 py-3">
                <h1 class="h4 m-0">Header Section</h1>
            </div>
        </div>

        <!-- Row 2: Middle (main content on the left, sidebar on the right) -->
        <div class="row flex-grow-1 gap-3 gap-md-0">
            <!-- Main content box -->
            <div class="col-12 col-md-9">
                <div class="border rounded bg-white h-100 p-4">
                    <h2 class="h5">Main Content</h2>
                    <p>Your main content goes here.</p>
                </div>
            </div>

            <!-- Right sidebar box -->
            <div class="col-12 col-md-3">
                <div class="border rounded bg-white h-100 p-4">
                    <h2 class="h5 mb-3">Pages</h2>
                    <div class="list-group">
                        @Html.ActionLink("Home", "Home", "NareshIT", null, new { @class = "list-group-item list-group-item-action" })
                        @Html.ActionLink("Courses", "Courses", "NareshIT", null, new { @class = "list-group-item list-group-item-action" })
                        @Html.ActionLink("Login", "Login", "NareshIT", null, new { @class = "list-group-item list-group-item-action" })
                        @Html.ActionLink("Register", "Register", "NareshIT", null, new { @class = "list-group-item list-group-item-action" })
                        @Html.ActionLink("About", "About", "NareshIT", null, new { @class = "list-group-item list-group-item-action" })
                    </div>
                </div>
            </div>

        </div>

        <!-- Row 3: Footer -->
        <div class="row border rounded bg-dark text-white">
            <div class="col py-3 text-center">
                <small>&copy; @DateTime.Now.Year - My MVC App</small>
            </div>
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>