
@model IEnumerable<MVCWithADO.Models.Student>

@{
    ViewBag.Title = "Student Details";
}

<h2>Student Details</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

<p>@Html.ActionLink("Add New Student", "AddStudent", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped table-bordered align-middle">
    <thead>
      <tr>
        <th>@Html.DisplayNameFor(S => S.Sid)</th>
        <th>@Html.DisplayNameFor(S => S.Name)</th>
        <th>@Html.DisplayNameFor(S => S.Class)</th>
        <th>@Html.DisplayNameFor(S => S.Fees)</th>
        <th>@Html.DisplayNameFor(S => S.Photo)</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
    @foreach (MVCWithADO.Models.Student student in Model)
    {
        <tr>
            <td>@student.Sid</td>
            <td>@student.Name</td>
            <td>@student.Class</td>
            <td>@student.Fees</td>
            <td>
                @if (!string.IsNullOrEmpty(student.Photo))
                {
                    <img src="@Url.Content("~/Uploads/" + student.Photo)" width="40" height="25" alt="Student photo" />
                }
                else
                {
                    <span>No image</span>
                }
            </td>
            <td class="text-nowrap">
                @Html.ActionLink("Details", "DisplayStudentOne", new { sid = student.Sid }, new { @class = "btn btn-sm btn-info" })
                @Html.ActionLink("Edit", "EditStudent", new { sid = student.Sid }, new { @class = "btn btn-sm btn-warning" })
                @using (Html.BeginForm("DeleteStudent", "Student", new { sid = student.Sid }, FormMethod.Post, new { style = "display:inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this student?');">Delete</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
