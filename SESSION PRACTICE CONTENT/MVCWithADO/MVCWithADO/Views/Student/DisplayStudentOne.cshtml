
@model MVCWithADO.Models.Student

@{
    ViewBag.Title = "Student Details";
}

<h2>Student Details</h2>

<table class="table table-bordered">
    <tr>
        <th>Student ID</th>
        <td>@Model.Sid</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Class</th>
        <td>@Model.Class</td>
    </tr>
    <tr>
        <th>Fees</th>
        <td>@Model.Fees</td>
    </tr>
    <tr>
        <th>Photo</th>
        <td>
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <img src="@Url.Content("~/Uploads/" + Model.Photo)" width="100" height="75" alt="Student photo" />
            }
            else
            {
                <span>No image</span>
            }
        </td>
    </tr>
</table>

<div>
    @Html.ActionLink("Back to Student List", "DisplayStudent", null, new { @class = "btn btn-link" })
</div>
