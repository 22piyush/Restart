@model MVCWithADO.Models.Student

@{
    ViewBag.Title = "Add Student";
}

<h2>Add New Student</h2>

@using (Html.BeginForm("AddStudent", "Student", FormMethod.Post,
    new { enctype = "multipart/form-data", @class = "mt-3" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "Please correct the following errors.", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(model => model.Name, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Class, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Class, new { @class = "form-control", type = "number", min = "1" })
        @Html.ValidationMessageFor(model => model.Class, null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Fees, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Fees, new { @class = "form-control", type = "number", min = "0", step = "0.01" })
        @Html.ValidationMessageFor(model => model.Fees, null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Photo, new { @class = "form-label" })
        <input type="file" name="selectedFile" accept=".jpg,.jpeg,.png,.gif" class="form-control" />
        @Html.ValidationMessage("selectedFile", new { @class = "text-danger" })
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="reset" class="btn btn-secondary">Reset</button>
        @Html.ActionLink("Back to Student Details", "DisplayStudent", null, new { @class = "btn btn-link" })
    </div>
}
